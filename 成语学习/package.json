{
  "name": "chengyu-leyuan",
  "version": "1.0.0",
  "private": true,
  "description": "成语学习乐园 —— 给孩子的平板 Web 学习应用",
  "scripts": {
    "build:content": "node scripts/build-content.js",
    "validate:content": "node scripts/validate-content.js",
    "audit:glyphs": "node scripts/audit-glyphs.js",
    "build": "npm run build:content && vite build",
    "start": "node server/index.js",
    "dev": "vite",
    "smoke": "node scripts/smoke-test.js",
    "backup:db": "node --experimental-sqlite scripts/backup-db.js",
    "check:db": "node --experimental-sqlite scripts/backup-db.js --check",
    "test": "npm run build:content && node --test tests/chain.test.mjs tests/shizi.test.mjs tests/registry.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pinia": "^3.0.2",
    "pinyin-pro": "^3.26.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.2.0"
  }
}
